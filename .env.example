DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Get a free key at https://exchangerate.host (or your provider of choice)
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key

# Shared secret required by the backend on every request (Authorization: Bearer <token>).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=change_me

# Exposed to the frontend build (Vite only exposes VITE_-prefixed vars to client code).
# Must match API_AUTH_TOKEN above.
VITE_API_TOKEN=change_me
VITE_API_BASE_URL=http://localhost:8000

FRONTEND_PORT=7070

# Get this from @BotFather on Telegram
TELEGRAM_BOT_API_KEY=your_telegram_bot_token

# Public HTTPS URL the bot's "Open app" button points to (e.g. an ngrok/cloudflared
# tunnel to the frontend during local dev, or your real domain in production).
WEBAPP_URL=https://your-public-url.example.com

# The bot calls the backend server-to-server over the Docker network, so the
# default (the "backend" service name) works out of the box in docker-compose
# and normally doesn't need to be set here.
# API_BASE_URL=http://backend:8000

# If the app is served from the domain root
VITE_BASE_URL=/

# Or, if the app is served from a subpath (replace '/myapp' with your actual path)
# VITE_BASE_URL=/myapp/
